pipeline {
    agent any

    stages {
        stage('building step') {
            steps {
                sh 'docker build -t salman98/myapp:latest .'
                sh 'docker tag salman98/myapp:latest salman98/myapp:$BUILD_NUMBER'
            }
        }
        stage('dockerhub login step') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'dockerhub', passwordVariable: 'pswd', usernameVariable: 'uname')]) {
                sh 'echo ${pswd} | docker login -u ${uname} --password-stdin'
                // password generate from jenkins credentials
            }
        }
        stage('push step') {
            steps {
                sh 'docker push salman98/myapp:$BUILD_NUMBER'
            }
        }
        stage('dockerhub logout step') {
            steps {
                sh 'docker logout'
            }
        }
        stage('new') {
            steps {
                script {
                    parallel (
                        "step 1": {
                            echo "1"
                        },
                        "step 2": {
                            echo "2"
                        }
                    )
                }
            }
        }
    }
}
