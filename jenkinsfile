pipeline {
    agent any

    stages {
        stage('building step') {
            steps {
                sh 'docker build -t myapp:latest'
                sh 'docker tag myapp:latest salman98/myapp:$BUILD_NUMBER'
            }
        }
        stage('dockerhub login') {
            steps {
                sh 'echo "dckr_pat_VYHpmPVWqqRrb46TVxax4zjZjDk" | docker login -u salman98 --password-stdin' //we will optimize later
            }
        }
        stage('push step') {
            steps {
                sh 'docker push salman98/myapp:$BUILD_NUMBER'
            }
        }
        stage('dockerhub logout step') {
            steps {
                sh 'docker logout'
            }
        }
        stage('new') {
            steps {
                script {
                    parallel (
                        "step 1": {
                            echo "1"
                        },
                        "step 2": {
                            echo "2"
                        }
                    )
                }
            }
        }
    }
}