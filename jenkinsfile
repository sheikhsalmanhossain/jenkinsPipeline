pipeline {
    agent any

    stages {
        stage('build') {
            steps {
                echo ' build done'
                //sh 'docker build -t myapp:latest'
                //sh 'docker tag myapp:latest salman98/myapp:latest'
            }
        }
        stage('push') {
            steps {
                echo 'push done'
                //sh 'docker push salman98/myapp:latest'
            }
        }
        stage('new') {
            steps {
                script {
                    parallel {
                        "step 1": {
                            echo "1"
                        }
                        "step 2": {
                            echo "2"
                        }
                    }
                }
            }
        }
    }
}